# Copy this file to .env and fill it in. .env is never committed to git.
# YouTube Data API v3 key (free): see docs/ASSESSMENT.md, section 4.
YOUTUBE_API_KEY=
# Absolute path to the Obsidian vault used for notes.
VAULT_PATH=
# Port of the app: http://127.0.0.1:5180
PORT=5180
# Optional: another folder for the database (checks use data/sandbox). Default: data
# DATA_DIR=data
# Optional: folder for backups. Default: backups (or DATA_DIR/backups when DATA_DIR is set)
# BACKUPS_DIR=backups
